generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model famille_fam {
  fam_id      Int              @id @default(autoincrement())
  fam_name    String
  collections collection_col[] @relation("Famille_Collections")

  @@index([fam_name], map: "te_famille_fam_fam_name_idx")
}

model collection_col {
  col_id        Int           @id @default(autoincrement())
  col_name      String
  col_familleId Int
  articles      article_art[] @relation("Collection_Articles")
  col_famille   famille_fam   @relation("Famille_Collections", fields: [col_familleId], references: [fam_id])

  @@index([col_familleId], map: "te_collection_col_col_familleId_idx")
  @@index([col_name], map: "te_collection_col_col_name_idx")
}

model article_art {
  art_id           Int               @id @default(autoincrement())
  art_reference    String?           @db.VarChar(100)
  art_name         String
  art_price        Int
  art_collectionId Int
  collection       collection_col    @relation("Collection_Articles", fields: [art_collectionId], references: [col_id])
  remises          remise_rem?       @relation("Article_Remise")
  devisLines       te_devisart_dea[]

  @@index([art_collectionId], map: "te_article_art_art_collectionId_idx")
  @@index([art_name], map: "te_article_art_art_name_idx")
}

model remise_rem {
  rem_id          Int         @id @default(autoincrement())
  rem_prixremise  Decimal?
  rem_pourcentage Decimal?
  rem_articleId   Int         @unique(map: "te_remise_rem_rem_articleId_key")
  article         article_art @relation("Article_Remise", fields: [rem_articleId], references: [art_id])

  @@index([rem_articleId], map: "te_remise_rem_rem_articleId_idx")
  @@index([rem_pourcentage], map: "te_remise_rem_rem_pourcentage_idx")
  @@index([rem_prixremise], map: "te_remise_rem_rem_prixremise_idx")
}

model te_devis_dev {
  dev_id                 Int               @id @default(autoincrement())
  dev_cli_id             String
  dev_veh_id             String
  dev_invoice_id         String?           @unique
  dev_user               String?
  dev_adressefacturation String?           @db.Text
  dev_numdevis           String            @unique
  dev_datecreation       DateTime          @default(now())
  dev_totalht            Decimal           @db.Decimal(14, 2)
  dev_totaltva           Decimal           @db.Decimal(14, 2)
  dev_totalttc           Decimal           @db.Decimal(14, 2)
  dev_tva                Decimal?          @db.Decimal(5, 2)
  dev_supprimee          Boolean           @default(false)
  dev_accordNumber       String?           @unique
  dev_dateAccord         DateTime?
  client                 client            @relation(fields: [dev_cli_id], references: [id], onDelete: Cascade)
  invoice                invoice?          @relation(fields: [dev_invoice_id], references: [id])
  user                   user?             @relation(fields: [dev_user], references: [id])
  vehicle                vehicle           @relation(fields: [dev_veh_id], references: [id], onDelete: Cascade)
  articles               te_devisart_dea[] @relation("Devis_Articles")

  @@index([dev_cli_id])
  @@index([dev_veh_id])
  @@index([dev_invoice_id])
  @@index([dev_user])
  @@index([dev_datecreation])
  @@index([dev_supprimee])
}

model te_devisart_dea {
  dea_id                Int          @id @default(autoincrement())
  dea_dev_id            Int
  dea_art_id            Int?
  dea_art_designation   String
  dea_art_reference     String?
  dea_prixunitaire      Decimal      @db.Decimal(14, 2)
  dea_quantite          Int
  dea_tva               Decimal?     @db.Decimal(5, 2)
  dea_pourcentageremise Int?
  dea_prixtotalht       Decimal      @db.Decimal(14, 2)
  article               article_art? @relation(fields: [dea_art_id], references: [art_id])
  devis                 te_devis_dev @relation("Devis_Articles", fields: [dea_dev_id], references: [dev_id], onDelete: Cascade)

  @@index([dea_dev_id])
  @@index([dea_art_id])
}

model client {
  id                        String         @id @default(cuid())
  name                      String
  email                     String?
  phone                     String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  cli_adresseFacturation    String?
  cli_numClient             String?
  cli_tvaIntraCommunautaire String?
  bases                     base[]
  devis                     te_devis_dev[]

  @@index([name], map: "Client_name_idx")
}

model base {
  id        String   @id @default(cuid())
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clientId  String
  client    client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId], map: "Base_clientId_idx")
  @@index([location], map: "Base_location_idx")
}

model vehicle {
  id                    String               @id @default(cuid())
  licensePlate          String               @unique(map: "Vehicle_licensePlate_key")
  year                  Int?
  color                 String?              @default("GRIS")
  entryDate             DateTime             @default(now())
  exitDate              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  clientId              String
  baseId                String
  handledById           String?
  bodyType              vehicle_bodyType?
  doorsCount            Int?
  energy                vehicle_energy?
  firstRegistrationDate DateTime?
  fiscalPowerCv         Int?
  gearboxType           vehicle_gearboxType?
  realPowerHp           Int?
  registrationCardDate  DateTime?
  version               String?
  brandId               String?
  modelId               String?
  devis                 te_devis_dev[]
  brand                 brand?               @relation(fields: [brandId], references: [id])

  @@index([baseId], map: "Vehicle_baseId_idx")
  @@index([clientId], map: "Vehicle_clientId_idx")
  @@index([handledById], map: "Vehicle_handledById_idx")
  @@index([licensePlate], map: "Vehicle_licensePlate_idx")
  @@index([brandId], map: "vehicle_brandId_fkey")
}

model invoice {
  id                 String         @id @default(cuid())
  accordNumber       String?        @unique(map: "Invoice_accordNumber_key")
  dateOfConfirmation DateTime?
  invoiceConfirmed   Boolean        @default(false)
  status             invoice_status @default(CONFIRMED_IN_PLANNING)
  statusUpdatedAt    DateTime       @default(now())
  workDescription    String?
  didOrderParts      Boolean        @default(false)
  ordersDetails      String?
  comments           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  vehicleId          String
  handledById        String?
  devis              te_devis_dev?

  @@index([accordNumber], map: "Invoice_accordNumber_idx")
  @@index([handledById], map: "Invoice_handledById_idx")
  @@index([invoiceConfirmed], map: "Invoice_invoiceConfirmed_idx")
  @@index([status], map: "Invoice_status_idx")
  @@index([vehicleId], map: "Invoice_vehicleId_idx")
}

model invoicephoto {
  id           String   @id @default(cuid())
  invoiceId    String
  blobName     String   @unique(map: "InvoicePhoto_blobName_key")
  url          String
  contentType  String?
  size         Int?
  createdAt    DateTime @default(now())
  uploadedById String?

  @@index([createdAt], map: "InvoicePhoto_createdAt_idx")
  @@index([invoiceId], map: "InvoicePhoto_invoiceId_idx")
}

model statushistory {
  id             String                       @id @default(cuid())
  previousStatus statushistory_previousStatus
  newStatus      statushistory_newStatus
  changedAt      DateTime                     @default(now())
  invoiceId      String
  changedById    String

  @@index([changedAt], map: "StatusHistory_changedAt_idx")
  @@index([changedById], map: "StatusHistory_changedById_idx")
  @@index([invoiceId], map: "StatusHistory_invoiceId_idx")
}

model changehistory {
  id         String   @id @default(cuid())
  invoiceId  String
  changedBy  String
  changedAt  DateTime @default(now())
  fieldName  String
  oldValue   String?
  newValue   String?
  changeType String

  @@index([changedAt], map: "ChangeHistory_changedAt_idx")
  @@index([invoiceId], map: "ChangeHistory_invoiceId_idx")
}

model user {
  id              String         @id @default(cuid())
  email           String         @unique(map: "User_email_key")
  name            String
  role            user_role
  password        String
  isSystemAccount Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  clientId        String?
  baseId          String?
  devisCreated    te_devis_dev[]

  @@index([email], map: "User_email_idx")
  @@index([role], map: "User_role_idx")
}

model brand {
  id        String    @id @default(cuid())
  name      String    @unique(map: "name")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  vehicle[]
}

model model {
  id        String   @id @default(cuid())
  name      String
  brandId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, brandId], map: "name")
}

enum user_role {
  ADMIN
  MANAGER
  MECHANIC
  CLIENT
  SIEGE
  AGENCE
}

enum invoice_status {
  CONFIRMED_IN_PLANNING
  WAITING_FOR_PARTS
  FIXING_STARTED
  FIXING_FINISHED
}

enum vehicle_bodyType {
  BERLINE
  SUV
  BREAK
  COUPE
  CABRIOLET
  MONOSPACE
  PICKUP
  UTILITAIRE
  AUTRE
}

enum vehicle_energy {
  GAZOLE
  ESSENCE
  HYBRIDE
  ELECTRIQUE
  GPL
}

enum vehicle_gearboxType {
  BVM
  BVA
}

enum statushistory_previousStatus {
  CONFIRMED_IN_PLANNING
  WAITING_FOR_PARTS
  FIXING_STARTED
  FIXING_FINISHED
}

enum statushistory_newStatus {
  CONFIRMED_IN_PLANNING
  WAITING_FOR_PARTS
  FIXING_STARTED
  FIXING_FINISHED
}

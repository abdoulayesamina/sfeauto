generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}
datasource db {
  provider = "mysql"
}
model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  name                  String
  role                  Role
  password              String
  isSystemAccount       Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  clientId              String?
  baseId                String?
  invoicesHandled       Invoice[]       @relation("InvoiceHandler")
  statusChanges         StatusHistory[] @relation("StatusChanger")
  changeHistory         ChangeHistory[] @relation("ChangeHistoryUser")
  uploadedInvoicePhotos InvoicePhoto[]  @relation("InvoicePhotoUploader")
  base            Base?     @relation(fields: [baseId], references: [id])
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehiclesHandled Vehicle[] @relation("VehicleHandler")
  devisCreated     te_devis_dev[] 
  @@index([email])
  @@index([role])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  cli_adresseFacturation String?
  cli_numClient String?
  cli_tvaIntraCommunautaire String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bases     Base[]
  users     User[]
  vehicles  Vehicle[]
  devis     te_devis_dev[]
  @@index([name])
}


model Base {
  id        String    @id @default(cuid())
  location  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  users     User[]
  vehicles  Vehicle[]
  @@index([clientId])
  @@index([location])
}

enum VehicleEnergy {
  GAZOLE
  ESSENCE
  HYBRIDE
  ELECTRIQUE
  GPL
}

enum GearboxType {
  BVM // boîte manuelle
  BVA // boîte automatique
}

enum BodyType {
  BERLINE
  SUV
  BREAK
  COUPE
  CABRIOLET
  MONOSPACE
  PICKUP
  UTILITAIRE
  AUTRE
}


model Vehicle {
  id           String    @id @default(cuid())
  licensePlate String    @unique

  model        String?
  brand        String?
  year         Int?

  color        String?   @default("GRIS")

  // 1ère MEC mise en circulation
  firstRegistrationDate DateTime?

  // Énergie
  energy       VehicleEnergy?

  //  Portes
  doorsCount   Int?

  // Carrosserie
  bodyType     BodyType?

  // Puissance réelle / fiscale
  realPowerHp      Int?
  fiscalPowerCv    Int?

  // Type de boîte
  gearboxType  GearboxType?

  // Version (ex: 1.6 CRDI)
  version      String?

  // Date carte grise
  registrationCardDate DateTime?

  entryDate    DateTime  @default(now())
  exitDate     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  clientId     String
  baseId       String
  handledById  String?

  invoices     Invoice[]
  devis        te_devis_dev[]

  base         Base      @relation(fields: [baseId], references: [id], onDelete: Cascade)
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  handledBy    User?     @relation("VehicleHandler", fields: [handledById], references: [id])

  @@index([licensePlate])
  @@index([clientId])
  @@index([baseId])
  @@index([handledById])
}

model InvoicePhoto {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  blobName    String   @unique
  url         String
  contentType String?
  size        Int?
  createdAt   DateTime @default(now())
  uploadedById String?
  uploadedBy   User?   @relation("InvoicePhotoUploader", fields: [uploadedById], references: [id])
  @@index([invoiceId])
  @@index([createdAt])
}
model Invoice {
  id                 String          @id @default(cuid())
  accordNumber       String?         @unique
  dateOfConfirmation DateTime?
  invoiceConfirmed   Boolean         @default(false)
  status             WorkStatus      @default(CONFIRMED_IN_PLANNING)
  statusUpdatedAt    DateTime        @default(now())
  workDescription    String?
  didOrderParts      Boolean         @default(false)
  ordersDetails      String?
  comments           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  vehicleId          String
  handledById        String?
  handledBy          User?           @relation("InvoiceHandler", fields: [handledById], references: [id])
  vehicle            Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  statusHistory      StatusHistory[]
  changeHistory      ChangeHistory[]
  photos             InvoicePhoto[]
  devis              te_devis_dev[]  
  @@index([accordNumber])
  @@index([vehicleId])
  @@index([status])
  @@index([invoiceConfirmed])
  @@index([handledById])
  @@index([invoiceConfirmed, status, createdAt])
}
model StatusHistory {
  id             String     @id @default(cuid())
  previousStatus WorkStatus
  newStatus      WorkStatus
  changedAt      DateTime   @default(now())
  invoiceId      String
  changedById    String
  changedBy      User       @relation("StatusChanger", fields: [changedById], references: [id], onDelete: Cascade)
  invoice        Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId])
  @@index([changedById])
  @@index([changedAt])
}
model ChangeHistory {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedBy  String
  user       User     @relation("ChangeHistoryUser", fields: [changedBy], references: [id])
  changedAt  DateTime @default(now())
  fieldName  String
  oldValue   String?
  newValue   String?
  changeType String
  @@index([invoiceId])
  @@index([changedAt])
}

model te_famille_fam {
  fam_id          Int          @id @default(autoincrement())
  fam_name        String
  collections te_collection_col[] @relation("Famille_Collections")

  @@index([fam_name])
}

model te_collection_col {
  col_id        Int      @id @default(autoincrement())
  col_name      String
  col_familleId Int
  col_famille   te_famille_fam  @relation("Famille_Collections", fields: [col_familleId], references: [fam_id])

  articles  te_article_art[] @relation("Collection_Articles")

  @@index([col_name])
  @@index([col_familleId])
}

model te_article_art {
  art_id        Int      @id @default(autoincrement())
  art_name      String
  art_price     Int
  art_collectionId Int
  collection te_collection_col @relation("Collection_Articles", fields: [art_collectionId], references: [col_id])
  remises   te_remise_rem? @relation("Article_Remise")

  devisLines te_devisart_dea[]  

  @@index([art_name])
  @@index([art_collectionId])
}

model te_remise_rem {
  rem_id Int @id @default(autoincrement())
  rem_prixremise Int?
  rem_pourcentage  Int?
  rem_articleId Int @unique
  article te_article_art @relation("Article_Remise", fields: [rem_articleId], references: [art_id])

  @@index([rem_prixremise])
  @@index([rem_pourcentage])
  @@index([rem_articleId])
}

model te_devis_dev {
  dev_id                 Int       @id @default(autoincrement())

  dev_cli_id              String
  dev_veh_id              String
  dev_invoice_id          String?
  
  @@unique([dev_invoice_id])
   
  dev_user                String?   

  client                  Client    @relation(fields: [dev_cli_id], references: [id], onDelete: Cascade)
  vehicle                 Vehicle   @relation(fields: [dev_veh_id], references: [id], onDelete: Cascade)
  invoice                 Invoice?  @relation(fields: [dev_invoice_id], references: [id], onDelete: SetNull)
  user                    User?     @relation(fields: [dev_user], references: [id], onDelete: SetNull)

  dev_adressefacturation  String?   @db.Text
  dev_numdevis            String    @unique

  dev_datecreation        DateTime  @default(now())

  dev_totalht             Decimal   @db.Decimal(14,2)
  dev_totaltva            Decimal   @db.Decimal(14,2)
  dev_totalttc            Decimal   @db.Decimal(14,2)

  dev_tva                 Decimal?  @db.Decimal(5,2) 
  dev_supprimee           Boolean   @default(false)

  dev_accordNumber        String?   @unique
  dev_dateAccord          DateTime?

  // lignes
  articles                te_devisart_dea[] @relation("Devis_Articles")

  @@index([dev_cli_id])
  @@index([dev_veh_id])
  @@index([dev_invoice_id])
  @@index([dev_user])
  @@index([dev_datecreation])
  @@index([dev_supprimee])
}

model te_devisart_dea {
  dea_id                 Int      @id @default(autoincrement())

  dea_dev_id             Int
  devis                  te_devis_dev @relation("Devis_Articles", fields: [dea_dev_id], references: [dev_id], onDelete: Cascade)

  // référence article (optionnel mais recommandé)
  dea_art_id              Int?
  article                 te_article_art? @relation(fields: [dea_art_id], references: [art_id], onDelete: SetNull)

  // snapshot au moment du devis (pro)
  dea_art_designation     String
  dea_art_reference       String?
  dea_prixunitaire        Decimal  @db.Decimal(14,2)
  dea_quantite            Int
  dea_tva                 Decimal? @db.Decimal(5,2)   
  dea_pourcentageremise   Int?    

  dea_prixtotalht         Decimal  @db.Decimal(14,2) 

  @@index([dea_dev_id])
  @@index([dea_art_id])
}


enum Role {
  ADMIN
  MANAGER
  MECHANIC
  CLIENT
  SIEGE
  AGENCE
}

enum WorkStatus {
  CONFIRMED_IN_PLANNING
  WAITING_FOR_PARTS
  FIXING_STARTED
  FIXING_FINISHED
}
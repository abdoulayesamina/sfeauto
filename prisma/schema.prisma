generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}
datasource db {
  provider = "mysql"
}
model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  name                  String
  role                  Role
  password              String
  isSystemAccount       Boolean         @default(false)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  clientId              String?
  baseId                String?
  invoicesHandled       Invoice[]       @relation("InvoiceHandler")
  statusChanges         StatusHistory[] @relation("StatusChanger")
  changeHistory         ChangeHistory[] @relation("ChangeHistoryUser")
  uploadedInvoicePhotos InvoicePhoto[]  @relation("InvoicePhotoUploader")
  base            Base?     @relation(fields: [baseId], references: [id])
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vehiclesHandled Vehicle[] @relation("VehicleHandler")
  @@index([email])
  @@index([role])
}
model Client {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bases     Base[]
  users     User[]
  vehicles  Vehicle[]
  @@index([name])
}
model Base {
  id        String    @id @default(cuid())
  location  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  users     User[]
  vehicles  Vehicle[]
  @@index([clientId])
  @@index([location])
}
model Vehicle {
  id           String    @id @default(cuid())
  licensePlate String    @unique
  model        String?
  brand        String?
  year         Int?
  color        String?
  entryDate    DateTime  @default(now())
  exitDate     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  clientId     String
  baseId       String
  handledById  String?
  invoices     Invoice[]
  base         Base      @relation(fields: [baseId], references: [id], onDelete: Cascade)
  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  handledBy    User?     @relation("VehicleHandler", fields: [handledById], references: [id])
  @@index([licensePlate])
  @@index([clientId])
  @@index([baseId])
  @@index([handledById])
}
model InvoicePhoto {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  blobName    String   @unique
  url         String
  contentType String?
  size        Int?
  createdAt   DateTime @default(now())
  uploadedById String?
  uploadedBy   User?   @relation("InvoicePhotoUploader", fields: [uploadedById], references: [id])
  @@index([invoiceId])
  @@index([createdAt])
}
model Invoice {
  id                 String          @id @default(cuid())
  accordNumber       String?         @unique
  dateOfConfirmation DateTime?
  invoiceConfirmed   Boolean         @default(false)
  status             WorkStatus      @default(CONFIRMED_IN_PLANNING)
  statusUpdatedAt    DateTime        @default(now())
  workDescription    String?
  didOrderParts      Boolean         @default(false)
  ordersDetails      String?
  comments           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  vehicleId          String
  handledById        String?
  handledBy          User?           @relation("InvoiceHandler", fields: [handledById], references: [id])
  vehicle            Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  statusHistory      StatusHistory[]
  changeHistory      ChangeHistory[]
  photos             InvoicePhoto[]
  @@index([accordNumber])
  @@index([vehicleId])
  @@index([status])
  @@index([invoiceConfirmed])
  @@index([handledById])
  @@index([invoiceConfirmed, status, createdAt])
}
model StatusHistory {
  id             String     @id @default(cuid())
  previousStatus WorkStatus
  newStatus      WorkStatus
  changedAt      DateTime   @default(now())
  invoiceId      String
  changedById    String
  changedBy      User       @relation("StatusChanger", fields: [changedById], references: [id], onDelete: Cascade)
  invoice        Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId])
  @@index([changedById])
  @@index([changedAt])
}
model ChangeHistory {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  changedBy  String
  user       User     @relation("ChangeHistoryUser", fields: [changedBy], references: [id])
  changedAt  DateTime @default(now())
  fieldName  String
  oldValue   String?
  newValue   String?
  changeType String
  @@index([invoiceId])
  @@index([changedAt])
}

model te_famille_fam {
  fam_id          Int          @id @default(autoincrement())
  fam_name        String
  collections te_collection_col[] @relation("Famille_Collections")

  @@index([fam_name])
}

model te_collection_col {
  col_id        Int      @id @default(autoincrement())
  col_name      String
  col_familleId Int
  col_famille   te_famille_fam  @relation("Famille_Collections", fields: [col_familleId], references: [fam_id])

  articles  te_article_art[] @relation("Collection_Articles")

  @@index([col_name])
  @@index([col_familleId])
}

model te_article_art {
  art_id        Int      @id @default(autoincrement())
  art_name      String
  art_price     Int
  art_collectionId Int 
  collection te_collection_col @relation("Collection_Articles", fields: [art_collectionId], references: [col_id])

  @@index([art_name])
  @@index([art_collectionId])
}

enum Role {
  ADMIN
  MANAGER
  MECHANIC
  CLIENT
}
enum WorkStatus {
  CONFIRMED_IN_PLANNING
  WAITING_FOR_PARTS
  FIXING_STARTED
  FIXING_FINISHED
}
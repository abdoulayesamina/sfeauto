generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model famille_fam {
  fam_id      Int              @id @default(autoincrement())
  fam_name    String
  collections collection_col[] @relation("Famille_Collections")

  @@index([fam_name])
}

model collection_col {
  col_id        Int           @id @default(autoincrement())
  col_name      String
  col_familleId Int
  articles      article_art[] @relation("Collection_Articles")
  col_famille   famille_fam   @relation("Famille_Collections", fields: [col_familleId], references: [fam_id])

  @@index([col_name])
  @@index([col_familleId])
}

model article_art {
  art_id           Int               @id @default(autoincrement())
  art_reference    String            @db.VarChar(100)
  art_name         String
  art_price        Decimal
  art_collectionId Int
  art_collection   collection_col    @relation("Collection_Articles", fields: [art_collectionId], references: [col_id])
  remises          remise_rem?       @relation("Article_Remise")
  devisLines       te_devisart_dea[]

  @@index([art_name])
  @@index([art_collectionId])
}

model remise_rem {
  rem_id          Int         @id @default(autoincrement())
  rem_prixremise  Decimal?
  rem_pourcentage Decimal?
  rem_articleId   Int         @unique
  rem_article     article_art @relation("Article_Remise", fields: [rem_articleId], references: [art_id])

  @@index([rem_prixremise])
  @@index([rem_pourcentage])
  @@index([rem_articleId])
}

model te_devis_dev {
  dev_id                 Int               @id @default(autoincrement())
  dev_cli_id             String
  dev_veh_id             String
  dev_intervention_id    String?           @unique
  dev_user_id            String?
  dev_adressefacturation String?           @db.Text
  dev_numdevis           String            @unique
  dev_datecreation       DateTime          @default(now())
  dev_totalht            Decimal           @db.Decimal(14, 2)
  dev_totaltva           Decimal           @db.Decimal(14, 2)
  dev_totalttc           Decimal           @db.Decimal(14, 2)
  dev_tva                Decimal?          @db.Decimal(5, 2)
  dev_supprimee          Boolean           @default(false)
  dev_accordNumber       String?           @unique
  dev_dateAccord         DateTime?
  dev_client             client_cli        @relation(fields: [dev_cli_id], references: [cli_id], onDelete: Cascade)
  dev_intervention       intervention_int? @relation(fields: [dev_intervention_id], references: [int_id])
  dev_user               user_usr?         @relation(fields: [dev_user_id], references: [usr_id])
  dev_vehicle            vehicle_veh       @relation(fields: [dev_veh_id], references: [veh_id], onDelete: Cascade)
  articles               te_devisart_dea[] @relation("Devis_Articles")

  @@index([dev_cli_id])
  @@index([dev_veh_id])
  @@index([dev_intervention_id])
  @@index([dev_user_id])
  @@index([dev_datecreation])
  @@index([dev_supprimee])
}

model te_devisart_dea {
  dea_id                Int          @id @default(autoincrement())
  dea_dev_id            Int
  dea_art_id            Int?
  dea_art_designation   String
  dea_art_reference     String?
  dea_prixunitaire      Decimal      @db.Decimal(14, 2)
  dea_quantite          Int
  dea_tva               Decimal?     @db.Decimal(5, 2)
  dea_pourcentageremise Int?
  dea_prixtotalht       Decimal      @db.Decimal(14, 2)
  dea_article           article_art? @relation(fields: [dea_art_id], references: [art_id])
  dea_devis             te_devis_dev @relation("Devis_Articles", fields: [dea_dev_id], references: [dev_id], onDelete: Cascade)

  @@index([dea_dev_id])
  @@index([dea_art_id])
}

model client_cli {
  cli_id                    String             @id @default(cuid())
  cli_name                  String
  cli_email                 String?
  cli_phone                 String?
  cli_createdAt             DateTime           @default(now())
  cli_updatedAt             DateTime           @updatedAt
  cli_adresseFacturation    String?
  cli_numClient             String?
  cli_tvaIntraCommunautaire String?
  bases                     base_bas[]
  interventions             intervention_int[] @relation("InterventionClient")
  devis                     te_devis_dev[]
  users                     user_usr[]
  vehicles                  vehicle_veh[]

  @@index([cli_name])
}

model base_bas {
  bas_id        String             @id @default(cuid())
  bas_location  String
  bas_createdAt DateTime           @default(now())
  bas_updatedAt DateTime           @updatedAt
  bas_clientId  String
  bas_client    client_cli         @relation(fields: [bas_clientId], references: [cli_id], onDelete: Cascade)
  interventions intervention_int[] @relation("InterventionBase")
  users         user_usr[]
  vehicles      vehicle_veh[]

  @@index([bas_clientId])
  @@index([bas_location])
}

model vehicle_veh {
  veh_id                    String               @id @default(cuid())
  veh_licensePlate          String               @unique
  veh_normalizedPlate       String?              @unique
  veh_year                  Int?
  veh_color                 String?              @default("GRIS")
  veh_firstRegistrationDate DateTime?
  veh_energy                vehicle_energy?
  veh_doorsCount            Int?
  veh_bodyType              vehicle_bodyType?
  veh_realPowerHp           Int?
  veh_fiscalPowerCv         Int?
  veh_gearboxType           vehicle_gearboxType?
  veh_version               String?
  veh_registrationCardDate  DateTime?
  veh_entryDate             DateTime             @default(now())
  veh_exitDate              DateTime?
  veh_createdAt             DateTime             @default(now())
  veh_updatedAt             DateTime             @updatedAt
  veh_clientId              String
  veh_baseId                String
  veh_handledById           String?
  veh_brandId               String?
  veh_modelId               String?
  veh_kilometrage           String?
  veh_absent                Boolean              @default(false)
  veh_dateAbsence           DateTime?
  interventions             intervention_int[]   @relation("VehicleInterventions")
  devis                     te_devis_dev[]
  veh_base                  base_bas             @relation(fields: [veh_baseId], references: [bas_id], onDelete: Cascade)
  veh_brand                 brand_bra?           @relation(fields: [veh_brandId], references: [bra_id])
  veh_client                client_cli           @relation(fields: [veh_clientId], references: [cli_id], onDelete: Cascade)
  veh_handledBy             user_usr?            @relation("VehicleHandler", fields: [veh_handledById], references: [usr_id])
  veh_model                 model_mod?           @relation(fields: [veh_modelId], references: [mod_id])

  @@index([veh_licensePlate])
  @@index([veh_normalizedPlate])
  @@index([veh_clientId])
  @@index([veh_baseId])
  @@index([veh_handledById])
  @@index([veh_absent])
  @@index([veh_brandId], map: "vehicle_veh_veh_brandId_fkey")
  @@index([veh_modelId], map: "vehicle_veh_veh_modelId_fkey")
}

model intervention_int {
  int_id                    String                  @id @default(cuid())
  int_accordNumber          String?
  int_dateOfConfirmation    DateTime?
  int_interventionConfirmed Boolean                 @default(false)
  int_status                intervention_status     @default(FIXING_STARTED)
  int_statusUpdatedAt       DateTime                @default(now())
  int_workDescription       String?
  int_didOrderParts         Boolean                 @default(false)
  int_ordersDetails         String?
  int_comments              String?                 @db.Text
  int_createdAt             DateTime                @default(now())
  int_updatedAt             DateTime                @updatedAt
  int_vehicleId             String
  int_handledById           String?
  int_kilometrage           String?
  int_supprimee             Boolean                 @default(false)
  int_annulee               Boolean                 @default(false)
  int_dateAnnulation        DateTime?
  int_baseId                String?
  int_clientId              String?
  changes                   changehistory_chg[]
  int_base                  base_bas?               @relation("InterventionBase", fields: [int_baseId], references: [bas_id])
  int_client                client_cli?             @relation("InterventionClient", fields: [int_clientId], references: [cli_id])
  int_handledBy             user_usr?               @relation("InterventionHandler", fields: [int_handledById], references: [usr_id])
  int_vehicle               vehicle_veh             @relation("VehicleInterventions", fields: [int_vehicleId], references: [veh_id], onDelete: Cascade)
  photos                    interventionphoto_itp[]
  history                   statushistory_sth[]
  notification              notification_not[]
  devis                     te_devis_dev?

  @@index([int_accordNumber])
  @@index([int_vehicleId])
  @@index([int_handledById])
  @@index([int_interventionConfirmed])
  @@index([int_status])
  @@index([int_supprimee])
  @@index([int_annulee])
  @@index([int_clientId])
  @@index([int_baseId])
}

model interventionphoto_itp {
  itp_id             String           @id @default(cuid())
  itp_interventionId String
  itp_blobName       String           @unique
  itp_url            String
  itp_contentType    String?
  itp_size           Int?
  itp_createdAt      DateTime         @default(now())
  itp_uploadedById   String?
  itp_intervention   intervention_int @relation(fields: [itp_interventionId], references: [int_id], onDelete: Cascade)
  itp_uploadedBy     user_usr?        @relation(fields: [itp_uploadedById], references: [usr_id])

  @@index([itp_interventionId])
  @@index([itp_createdAt])
  @@index([itp_uploadedById], map: "interventionphoto_itp_itp_uploadedById_fkey")
}

model statushistory_sth {
  sth_id             String                               @id @default(cuid())
  sth_previousStatus statushistory_sth_sth_previousStatus
  sth_newStatus      statushistory_sth_sth_newStatus
  sth_changedAt      DateTime                             @default(now())
  sth_interventionId String
  sth_changedById    String
  sth_user           user_usr                             @relation(fields: [sth_changedById], references: [usr_id], onDelete: Cascade)
  sth_intervention   intervention_int                     @relation(fields: [sth_interventionId], references: [int_id], onDelete: Cascade)

  @@index([sth_interventionId])
  @@index([sth_changedById])
  @@index([sth_changedAt])
}

model changehistory_chg {
  chg_id             String           @id @default(cuid())
  chg_interventionId String
  chg_changedBy      String
  chg_changedAt      DateTime         @default(now())
  chg_fieldName      String
  chg_oldValue       String?
  chg_newValue       String?          @db.Text
  chg_changeType     String
  chg_user           user_usr         @relation(fields: [chg_changedBy], references: [usr_id])
  chg_intervention   intervention_int @relation(fields: [chg_interventionId], references: [int_id], onDelete: Cascade)

  @@index([chg_interventionId])
  @@index([chg_changedAt])
  @@index([chg_changedBy], map: "changehistory_chg_chg_changedBy_fkey")
}

model user_usr {
  usr_id                     String                  @id @default(cuid())
  usr_email                  String                  @unique
  usr_name                   String
  usr_role                   user_role
  usr_password               String
  usr_isSystemAccount        Boolean                 @default(false)
  usr_createdAt              DateTime                @default(now())
  usr_updatedAt              DateTime                @updatedAt
  usr_clientId               String?
  usr_baseId                 String?
  changeHistory              changehistory_chg[]
  interventionsHandled       intervention_int[]      @relation("InterventionHandler")
  uploadedInterventionPhotos interventionphoto_itp[]
  statusChanges              statushistory_sth[]
  devisCreated               te_devis_dev[]
  usr_base                   base_bas?               @relation(fields: [usr_baseId], references: [bas_id])
  usr_client                 client_cli?             @relation(fields: [usr_clientId], references: [cli_id])
  vehiclesHandled            vehicle_veh[]           @relation("VehicleHandler")
  notification               notification_not[]

  @@index([usr_email])
  @@index([usr_role])
  @@index([usr_baseId], map: "user_usr_usr_baseId_fkey")
  @@index([usr_clientId], map: "user_usr_usr_clientId_fkey")
}

model brand_bra {
  bra_id        String        @id @default(cuid())
  bra_name      String        @unique
  bra_createdAt DateTime      @default(now())
  bra_updatedAt DateTime      @updatedAt
  models        model_mod[]
  vehicles      vehicle_veh[]
}

model model_mod {
  mod_id        String        @id @default(cuid())
  mod_name      String
  mod_brandId   String
  mod_createdAt DateTime      @default(now())
  mod_updatedAt DateTime      @updatedAt
  mod_brand     brand_bra     @relation(fields: [mod_brandId], references: [bra_id], onDelete: Cascade)
  vehicles      vehicle_veh[]

  @@unique([mod_name, mod_brandId])
  @@index([mod_brandId], map: "model_mod_mod_brandId_fkey")
}

model notification_not {
  not_id             String            @id @default(cuid())
  not_title          String
  not_message        String            @db.Text
  not_url            String?
  not_type           NotificationType
  not_isRead         Boolean           @default(false)
  not_userId         String
  not_interventionId String?
  not_createdAt      DateTime          @default(now())
  user               user_usr          @relation(fields: [not_userId], references: [usr_id])
  intervention       intervention_int? @relation(fields: [not_interventionId], references: [int_id], onDelete: SetNull)

  @@index([not_userId])
  @@index([not_isRead])
  @@index([not_createdAt])
}

enum NotificationType {
  INTERVENTION_CREATED
  INTERVENTION_UPDATED
  INTERVENTION_CANCELLED
}

enum user_role {
  ADMIN
  MANAGER
  MECHANIC
  CLIENT
  SIEGE
  AGENCE
}

enum intervention_status {
  WAITING_FOR_PARTS
  FIXING_STARTED
  FIXING_FINISHED
}

enum vehicle_bodyType {
  BERLINE
  SUV
  BREAK
  COUPE
  CABRIOLET
  MONOSPACE
  PICKUP
  UTILITAIRE
  AUTRE
}

enum vehicle_energy {
  GAZOLE
  ESSENCE
  HYBRIDE
  ELECTRIQUE
  GPL
}

enum vehicle_gearboxType {
  BVM
  BVA
}

enum statushistory_sth_sth_previousStatus {
  WAITING_FOR_PARTS
  FIXING_STARTED
  FIXING_FINISHED
}

enum statushistory_sth_sth_newStatus {
  WAITING_FOR_PARTS
  FIXING_STARTED
  FIXING_FINISHED
}

enum WorkStatus {
  WAITING_FOR_PARTS
  FIXING_STARTED
  FIXING_FINISHED
}
